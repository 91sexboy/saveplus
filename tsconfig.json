{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["./dev/telebox-host/utils/*"]
    }
  },
  "include": ["saveplus.ts", "tests/**/*.ts", "dev/**/*.ts"]
}
